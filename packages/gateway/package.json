{
  "name": "@drawbridge/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Drawbridge gateway: stdio MCP server, upstream router, and CLI.",
  "bin": {
    "drawbridge": "./dist/cli.js"
  },
  "exports": {
